# 로컬 개발용 환경변수 예시. 이 파일을 .env.local로 복사한 뒤 값을 채운다.
# 값은 Vercel 프로젝트 Settings → Environment Variables에서 가져온다. 실제 값은 절대 커밋하지 않는다.

# Neon Postgres 연결 문자열. 수동 검증 때는 운영 DB 대신 Neon 브랜치(운영 데이터 복사본) 주소를 권장한다.
DATABASE_URL=

# 세션 JWT 서명 키
AUTH_SECRET=

# 로컬에서는 반드시 http://localhost:3000 으로 둔다.
# 운영 주소를 그대로 넣으면 proxy가 모든 요청을 운영 사이트로 리다이렉트한다.
NEXTAUTH_URL=http://localhost:3000

# Google OAuth 클라이언트. 콘솔의 승인된 리디렉션 URI에
# http://localhost:3000/api/auth/callback/google 이 등록돼 있어야 로컬 로그인이 된다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 쉼표로 구분한 관리자 이메일. 이 이메일로 로그인하면 승인 없이 ADMIN이 된다.
ADMIN_EMAILS=

# 대시보드 주간 일정을 읽을 구글 캘린더
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# (선택) 메타데이터 기준 URL. NEXTAUTH_URL이 없을 때 사용
NEXT_PUBLIC_SITE_URL=
